# Copy this file to .env and fill in real values.
# Never put real values in this file. It is committed to GitHub.

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Auth secrets (long random text, at least 32 characters each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Protects scheduled jobs from being called by strangers
CRON_SECRET=

# Public address of the app
APP_URL=http://localhost:5173

# Email sending
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=

# AI tutor
AI_PROVIDER=gemini
AI_API_KEY=

# Live news
NEWS_API_KEY=

# Stock market data
MARKET_API_KEY=

# Error monitoring
SENTRY_DSN=